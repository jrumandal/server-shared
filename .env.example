# Example environment — copy to `.env` and adjust for your machine.
#   cp .env.example .env

# Service identity (used in logs / health)
SERVICE_NAME="server-shared"
PORT=4001
NODE_ENV="development"

# PostgreSQL connection (matches the reference docker-compose.yml)
DATABASE_URL="postgresql://mf:mf@localhost:5432/microfrontend?schema=public"

# Prisma
PRISMA_CLIENT_ENGINE_TYPE="binary"
